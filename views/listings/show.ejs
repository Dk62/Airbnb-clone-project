<%- layout("/layouts/boilerplates") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>
                <%= listing.title %>
            </h3>
        </div>
        <div class="card col-6 offset-2 show-card listing-card">
            <img src="<%= listing.image.url ? listing.image.url : listing.image %>" class="card-img-top show-img"
                alt="listing_image">
            <div class="card-body ">
                <p class="card-text"> Owned by<i>
                        <%= listing.owner ? listing.owner.username : "unknown" %>
                    </i></p>
                <p class="card-text">
                    <%= listing.description %>
                </p>
                <p class="card-text">&#x20B9; <%= Number(listing.price || 0).toLocaleString("en-IN") %>
                </p>
                <p class="card-text">
                    <%= listing.location %>
                </p>
                <p class="card-text">
                    <%= listing.country %>
                </p>
            </div>
        </div>
        <br />
        <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark offset-2  edit-btn">Edit</a>
                <br /> <br />
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark offset-5">Delete</button>
                </form>
            </div>
            <% } %>


                <div class="col-8 offset-4 mb-4" style="margin-left: 16.5%;">
                    <hr />
                    <% if(currUser) { %>
                        <h4>Leave a Review</h4>
                        <form action="/listings/<%= listing._id %>/review" method="POST" class="needs-validation"
                            novalidate>
                            <div class="mb-3 mt-3">
                                <label for="rating" class="form-label">Rating</label>
                                <div class="star-rating" id="star-rating">
                                    <input type="checkbox" id="1-stars" data-value="1" /><label for="1-stars"
                                        class="star">&#9733;</label>
                                    <input type="checkbox" id="2-stars" data-value="2" /><label for="2-stars"
                                        class="star">&#9733;</label>
                                    <input type="checkbox" id="3-stars" data-value="3" /><label for="3-stars"
                                        class="star">&#9733;</label>
                                    <input type="checkbox" id="4-stars" data-value="4" /><label for="4-stars"
                                        class="star">&#9733;</label>
                                    <input type="checkbox" id="5-star" data-value="5" /><label for="5-star"
                                        class="star">&#9733;</label>
                                </div>
                                <input type="hidden" name="review[rating]" id="rating-value" value="">
                                <div class="invalid-feedback">Please select a rating.</div>
                            </div>
                            <div class="mb-3 mt-3">
                                <label for="comment" class="form-label">Comment</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">
                                    Please fill out a comment for your review.
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success">Submit</button>
                        </form>
                </div>
                <% } %>

                    <% if(listing.review && listing.review.length> 0) { %>
                        <div class="row" style="margin-left: 15%">
                            <h4>All Reviews</h4>
                            <% for(let review of listing.review) { %>
                                <div class="card col-4 ms-3 mb-3 ">
                                    <div class="card-body">
                                        <h5 class="card-title">@<%= review.author.username %>
                                                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                                        </h5>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>

                                        <form class="mb-3" method="POST"
                                            action="/listings/<%=listing._id%>/review/<%=review._id%>?_method=DELETE">
                                            <button class="btn btn-sm btn-dark">Delete</button>
                                        </form>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                        <% } %>


        </div>

    </div>

    <!-- Map Section -->
    <div class="row mt-5">
        <div class="col-8 offset-2" style="margin-left: 300px;">
            <h3 style="margin-left: 45px;">Where You'll Be</h3>
            <div id="map" style="height: 400px; width: 700px; border-radius: 8px; margin-bottom: 30px; margin-left: 50px;"></div>
        </div>
    </div>

  
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const starCheckboxes = document.querySelectorAll('#star-rating input[type="checkbox"]');
            const ratingValue = document.getElementById('rating-value');

            starCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    const selectedValue = parseInt(this.getAttribute('data-value'));

                    // Check all stars with value less than or equal to selected
                    starCheckboxes.forEach(cb => {
                        if (parseInt(cb.getAttribute('data-value')) <= selectedValue && this.checked) {
                            cb.checked = true;
                        } else if (parseInt(cb.getAttribute('data-value')) > selectedValue) {
                            cb.checked = false;
                        }
                    });

                    // Get the highest selected rating
                    let maxRating = 0;
                    starCheckboxes.forEach(cb => {
                        if (cb.checked) {
                            maxRating = Math.max(maxRating, parseInt(cb.getAttribute('data-value')));
                        }
                    });

                    // Set the hidden input value
                    ratingValue.value = maxRating;
                });
            });
        });

        // Initialize Leaflet Map
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(() => {
                const map = L.map('map').setView([19.0760, 72.8777], 13);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 19
                }).addTo(map);

                const location = `<%= listing.location %>, <%= listing.country %>`;

                if (location && location.trim() && location !== ",") {
                    fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(location)}&format=json`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.length > 0) {
                                const place = data[0];
                                const lat = parseFloat(place.lat);
                                const lon = parseFloat(place.lon);

                                map.setView([lat, lon], 13);

                                L.marker([lat, lon]).addTo(map)
                                    .bindPopup(`<b><%= listing.title %></b><br/>Location: ${location}`)
                                    .openPopup();
                            }
                        })
                        .catch(error => console.log('Geocoding error:', error));
                }
            }, 100);
        });
    </script>